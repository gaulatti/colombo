# App
PORT=8080
COLOMBO_FTP_PORT=2121
COLOMBO_FTP_PASSIVE_PORTS=60000-60100
# COLOMBO_FTP_PASSIVE_EXTERNAL_ADDRESS=203.0.113.10
COLOMBO_FTP_ENABLED=true
# Durable receipts, retry state, and accepted bytes. Mount this path persistently in containers.
COLOMBO_SPOOL_PATH=/var/lib/colombo/spool

# Optional bearer token enabling /actuator/prometheus (minimum 16 characters)
COLOMBO_METRICS_TOKEN=replace-with-a-long-random-token
# COLOMBO_BUILD_VERSION=development

# Optional FTP-only support bypass
# COLOMBO_MASTER_PASSWORD=replace-me

# Optional explicit FTPS. Set both paths or neither; ordinary FTP remains enabled.
# COLOMBO_FTPS_CERTIFICATE_PATH=/etc/letsencrypt/live/colombo.gaulatti.com/fullchain.pem
# COLOMBO_FTPS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/colombo.gaulatti.com/privkey.pem

# Database (preferred names)
DATABASE_URL=jdbc:postgresql://localhost:5432/colombo
DATABASE_USER=colombo
DATABASE_PASSWORD=change-me

# Optional compatibility aliases (used as fallback if DATABASE_* are absent)
# DB_URL=jdbc:postgresql://localhost:5432/colombo
# DB_USERNAME=colombo
# DB_PASSWORD=change-me

# Migration compatibility
FLYWAY_ENABLED=true
